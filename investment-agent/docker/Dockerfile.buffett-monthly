FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    google-cloud-bigquery>=3.17 \
    google-cloud-storage>=2.16 \
    db-dtypes>=1.2

COPY scripts/buffett_monthly_scrape.py scripts/buffett_monthly_scrape.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/buffett_monthly_scrape.py"]
