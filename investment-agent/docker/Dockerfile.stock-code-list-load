FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    beautifulsoup4>=4.12 \
    lxml>=5.0 \
    xlrd>=2.0 \
    pandas>=2.0 \
    openpyxl>=3.1 \
    "google-cloud-bigquery[pandas]>=3.0"

COPY scripts/stock_code_list_load.py scripts/stock_code_list_load.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/stock_code_list_load.py"]
