FROM python:3.12-slim

WORKDIR /app

# 依存インストール（irbank_tdnet_download.py が必要とするパッケージのみ）
RUN pip install --no-cache-dir \
    curl-cffi>=0.6 \
    google-cloud-storage>=2.16

COPY scripts/irbank_tdnet_download.py scripts/irbank_tdnet_download.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/irbank_tdnet_download.py"]
