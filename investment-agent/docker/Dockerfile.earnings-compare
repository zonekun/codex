FROM python:3.12-slim

# システム依存（Ollama インストール用 + PDF 処理用）
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Ollama インストール（モデルは GCS FUSE マウントで提供）
RUN curl -fsSL https://ollama.ai/install.sh | sh

WORKDIR /app

# Python 依存インストール
RUN pip install --no-cache-dir \
    "google-cloud-bigquery>=3.20" \
    "google-cloud-storage>=2.16" \
    "google-auth>=2.22" \
    "pdfplumber>=0.11" \
    "structlog>=24.0" \
    "tenacity>=8.0" \
    "requests>=2.31"

# スクリプトコピー
COPY scripts/earnings_compare/ scripts/earnings_compare/

# Cloud Run Job 必須設定
ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

# Ollama がモデルを /root/.ollama に期待する（GCS FUSE マウント先と一致）
ENV OLLAMA_MODELS=/root/.ollama/models

ENTRYPOINT ["python", "-m", "scripts.earnings_compare.main"]
