FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    beautifulsoup4>=4.12 \
    lxml>=5.0 \
    google-cloud-storage>=2.16 \
    google-cloud-bigquery>=3.0 \
    google-auth>=2.0 \
    pandas>=2.0 \
    openpyxl>=3.1 \
    db-dtypes>=1.0 \
    google-genai>=1.0 \
    pdfplumber>=0.10 \
    pymupdf>=1.24 \
    xlrd>=2.0

COPY scripts/extract_monthly_data.py scripts/extract_monthly_data.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/extract_monthly_data.py"]
