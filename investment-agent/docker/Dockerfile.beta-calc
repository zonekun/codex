FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    pandas>=2.0 \
    pyarrow>=15.0 \
    "google-cloud-bigquery[pandas]>=3.0" \
    google-cloud-storage>=2.0 \
    python-dotenv>=1.0

COPY scripts/beta_calc.py scripts/beta_calc.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/beta_calc.py"]
