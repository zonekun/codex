FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    pandas>=2.0 \
    openpyxl>=3.1 \
    xlrd>=2.0.1 \
    beautifulsoup4>=4.12 \
    lxml>=4.9 \
    tqdm>=4.66 \
    urllib3>=2.0 \
    google-cloud-storage>=2.16

COPY scripts/edinet_xbrl_extractor.py scripts/edinet_xbrl_extractor.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/edinet_xbrl_extractor.py"]
