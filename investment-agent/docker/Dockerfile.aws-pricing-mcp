FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# AWS Pricing MCP サーバーを GitHub から直接インストール
RUN pip install --no-cache-dir \
    "awslabs.aws-pricing-mcp-server @ git+https://github.com/awslabs/mcp.git#subdirectory=src/aws-pricing-mcp-server"

# uvicorn: SSE ASGI サーバー起動に必要
RUN pip install --no-cache-dir uvicorn

# Cloud Run 用エントリーポイントをコピー
COPY scripts/aws_pricing_mcp_server.py scripts/aws_pricing_mcp_server.py

ENV PYTHONUNBUFFERED=1

EXPOSE 8080

ENTRYPOINT ["python", "scripts/aws_pricing_mcp_server.py"]
