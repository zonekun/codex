FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    jpholiday \
    pandas>=2.0 \
    pyarrow>=15.0 \
    "google-cloud-bigquery[pandas]>=3.0" \
    "pandas-gbq>=0.26.1" \
    requests>=2.31 \
    python-dotenv>=1.0

COPY scripts/stock_price_jquants_load.py scripts/stock_price_jquants_load.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/stock_price_jquants_load.py"]
