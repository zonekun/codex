FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    structlog>=24.1 \
    google-cloud-run>=0.10

COPY scripts/check_duplicate_triggers.py scripts/check_duplicate_triggers.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/check_duplicate_triggers.py"]
