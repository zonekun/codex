FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    pandas>=2.2 \
    db-dtypes>=1.2 \
    structlog>=24.1 \
    google-cloud-bigquery>=3.20

COPY scripts/earnings_actual_load.py scripts/earnings_actual_load.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/earnings_actual_load.py"]
