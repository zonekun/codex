FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "awslabs.cost-explorer-mcp-server @ git+https://github.com/awslabs/mcp.git#subdirectory=src/cost-explorer-mcp-server"

RUN pip install --no-cache-dir uvicorn

COPY scripts/aws_cost_explorer_mcp_server.py scripts/aws_cost_explorer_mcp_server.py

ENV PYTHONUNBUFFERED=1

EXPOSE 8080

ENTRYPOINT ["python", "scripts/aws_cost_explorer_mcp_server.py"]
