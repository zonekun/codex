FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    google-cloud-storage>=2.16 \
    google-cloud-bigquery>=3.0 \
    google-genai>=1.0 \
    langchain-text-splitters>=0.2 \
    beautifulsoup4>=4.12 \
    lxml>=4.9

COPY scripts/edinet_load_parallel.py scripts/edinet_load_parallel.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/edinet_load_parallel.py"]
