FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    dropbox>=12.0 \
    pandas>=2.2 \
    openpyxl>=3.1 \
    yfinance>=0.2 \
    structlog>=24.1 \
    requests>=2.31

COPY scripts/faber_timing.py scripts/faber_timing.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1

ENTRYPOINT ["python", "scripts/faber_timing.py"]
