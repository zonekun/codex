FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    google-cloud-storage>=2.16 \
    google-cloud-bigquery>=3.0 \
    google-auth>=2.0 \
    pandas>=2.0 \
    db-dtypes>=1.0

COPY scripts/investigate_type_c_urls.py scripts/investigate_type_c_urls.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/investigate_type_c_urls.py"]
