FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    jpholiday \
    pandas>=2.0 \
    yfinance>=0.2 \
    "google-cloud-bigquery[pandas]>=3.0"

COPY scripts/stock_price_yf_am_load.py scripts/stock_price_yf_am_load.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/stock_price_yf_am_load.py"]
