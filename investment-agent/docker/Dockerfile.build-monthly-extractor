FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    urllib3>=2.0 \
    beautifulsoup4>=4.12 \
    lxml>=5.0 \
    google-cloud-storage>=2.16 \
    google-cloud-bigquery>=3.0 \
    google-auth>=2.0 \
    google-genai>=1.0 \
    pandas>=2.0 \
    openpyxl>=3.1 \
    xlrd>=2.0.1 \
    pdfplumber>=0.11

COPY scripts/build_monthly_extractor.py scripts/build_monthly_extractor.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/build_monthly_extractor.py"]
