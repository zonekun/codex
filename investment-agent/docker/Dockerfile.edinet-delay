FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    dropbox>=11.36 \
    openpyxl>=3.1

COPY scripts/edinet_delay.py scripts/edinet_delay.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/edinet_delay.py"]
