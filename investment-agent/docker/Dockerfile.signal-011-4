FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    numpy>=1.26 \
    pandas>=2.0 \
    pyarrow>=15.0 \
    scipy>=1.12 \
    yfinance>=0.2.36 \
    structlog>=24.0 \
    tenacity>=8.0 \
    "google-cloud-bigquery[pandas]>=3.0" \
    google-cloud-storage>=2.0

COPY scripts/signal_011_4_daily.py scripts/signal_011_4_daily.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/signal_011_4_daily.py"]
