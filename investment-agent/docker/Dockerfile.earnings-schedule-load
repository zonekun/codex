FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    requests>=2.31 \
    beautifulsoup4>=4.12 \
    lxml>=4.9 \
    pandas>=2.2 \
    structlog>=24.1 \
    google-cloud-bigquery>=3.20 \
    dropbox>=11.36

COPY scripts/earnings_schedule_load.py scripts/earnings_schedule_load.py
COPY scripts/notify.py scripts/notify.py

ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/earnings_schedule_load.py"]
