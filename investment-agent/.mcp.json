{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "jquants-doc": {
      "command": "j-quants-doc-mcp"
    },
    "fred": {
      "command": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": [
        "-c",
        "TOKEN=$(gcloud auth print-identity-token 2>/dev/null); exec uvx mcp-remote https://fred-mcp-480182964684.us-west1.run.app/sse --header \"Authorization: Bearer ${TOKEN}\""
      ]
    },
    "gcp": {
      "command": "C:\\venvs\\investment-agent\\Scripts\\python.exe",
      "args": [
        "C:\\gdrive\\claude\\investment-agent\\scripts\\gcp_mcp_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "aws": {
      "command": "uvx",
      "args": [
        "--from",
        "awslabs.aws-api-mcp-server@latest",
        "awslabs.aws-api-mcp-server.exe"
      ],
      "env": {
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
