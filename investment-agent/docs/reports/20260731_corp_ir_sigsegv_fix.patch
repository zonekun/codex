+# 隔離抽出のサブプロセス timeout（秒）。ハング PDF の保険（通常抽出は数秒で終わる）。
+_ISOLATED_EXTRACT_TIMEOUT = 120
+
+
+def _isolated_worker_argv(in_path: str, out_path: str) -> list[str]:
+    """隔離抽出の子プロセス起動 argv を組む（テストで差し替え可能なシーム）。"""
+    import sys  # noqa: PLC0415
+
+    return [sys.executable, "-m", "src.llm.pdf_extract_chunk",
+            "--extract", in_path, out_path]
+
+
+def extract_text_pymupdf_isolated(
+    pdf_bytes: bytes, *, timeout: int = _ISOLATED_EXTRACT_TIMEOUT
+) -> tuple[str, int]:
+    """`extract_text_pymupdf` を**別プロセスで**実行し、ネイティブクラッシュを封じ込める。
+
+    PyMuPDF(MuPDF) は不正 PDF（例: stitching function のサブ関数過多）に対し C++ 例外
+    `mupdf::FzErrorLimit` を throw し `std::terminate` → SIGSEGV/SIGABRT でプロセスごと落ちる
+    ことがある。ネイティブ層の terminate は Python の `try/except` では捕捉できず、同一プロセスの
+    `ThreadPoolExecutor` で回している Load 相では **1 つの PDF が Job 全体を道連れにする**
+    （tools-106 / corporate-ir-pipeline SIGSEGV 事象）。本関数は抽出を子プロセスへ隔離し、子が
+    signal 死（`returncode < 0`）・非0終了・timeout した場合は `("", 0)` を返す＝呼び出し側の
+    pdfminer フォールバックへ委ねる（当該 PDF のみ skip、Job は継続）。
+
+    戻り値・`[PAGE N]` マーカー・正規化は `extract_text_pymupdf` と同一（同関数を子側で呼ぶ）。
+    子プロセスは `python -m src.llm.pdf_extract_chunk --extract <in> <out>` として本モジュールを
+    再実行する（下部 `__main__` 参照）。PDF は一時ファイル経由で受け渡す（大容量 PDF 対応）。
+    """
+    import contextlib  # noqa: PLC0415
+    import subprocess  # noqa: PLC0415
+    import tempfile  # noqa: PLC0415
+    from pathlib import Path  # noqa: PLC0415
+
+    # プロジェクトルート（<root>/src/llm/pdf_extract_chunk.py → parents[2]）を cwd に据え、
+    # `-m src.llm.pdf_extract_chunk` を解決可能にする。
+    project_root = Path(__file__).resolve().parents[2]
+    in_path = out_path = None
+    try:
+        with tempfile.NamedTemporaryFile(suffix=".pdf", delete=False) as fin:
+            fin.write(pdf_bytes)
+            in_path = fin.name
+        with tempfile.NamedTemporaryFile(suffix=".txt", delete=False) as fout:
+            out_path = fout.name
+        env = dict(os.environ)
+        env["PYTHONPATH"] = os.pathsep.join(
+            [str(project_root), env.get("PYTHONPATH", "")]
+        ).strip(os.pathsep)
+        try:
+            proc = subprocess.run(
+                _isolated_worker_argv(in_path, out_path),
+                capture_output=True, text=True, cwd=str(project_root),
+                env=env, timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            return "", 0
+        if proc.returncode != 0:
+            # returncode < 0 は signal 死（-11=SIGSEGV, -6=SIGABRT）＝ネイティブクラッシュ。
+            # 非0終了も含め抽出失敗として空を返し、呼び出し側の pdfminer フォールバックへ委ねる。
+            return "", 0
+        try:
+            page_count = int((proc.stdout or "0").strip() or "0")
+        except ValueError:
+            page_count = 0
+        try:
+            text = Path(out_path).read_text(encoding="utf-8")
+        except OSError:
+            return "", 0
+        return text, page_count
+    finally:
+        for p in (in_path, out_path):
+            if p is not None:
+                with contextlib.suppress(OSError):  # 未生成/既削除は無害
+                    os.unlink(p)
+
+
