index 0000000..b7b71eb
--- /dev/null
+++ b/investment-agent/tests/test_pdf_extract_isolation.py
@@ -0,0 +1,79 @@
+"""corporate-ir-pipeline Load 相 SIGSEGV 対策の回帰テスト（tools-106 / TASK 00072）.
+
+背景（一次ログ逐語）:
+  PyMuPDF(MuPDF) が不正 PDF（"too many sub-functions in stitching function"）に対し
+  C++ 例外 `mupdf::FzErrorLimit`（"exception stack overflow"）を throw → `std::terminate`
+  → `Container terminated on signal 11`。ネイティブ層 terminate は Python の try/except で
+  捕捉できず、Load 相の `ThreadPoolExecutor`（同一プロセス）では 1 つの PDF が Job 全体を
+  道連れにする。対策として PyMuPDF 抽出を**別プロセス隔離**する（`extract_text_pymupdf_isolated`）。
+
+本テストの契約:
+  (a) 挙動保存 — 隔離版は通常 PDF で直接版（`extract_text_pymupdf`）と同一の (text, page_count)
+      を返す（[PAGE N] マーカー・正規化を含む）。
+  (b) 封じ込め — 子プロセスが signal 死（SIGSEGV/SIGABRT 相当）しても、親は生存し ("", 0) を
+      返す（＝呼び出し側の pdfminer フォールバックへ委ね、Job は継続する）。
+
+実行: PYTHONUTF8=1 <python> -m pytest tests/test_pdf_extract_isolation.py -q
+"""
+
+from __future__ import annotations
+
+import pathlib
+import sys
+
+import pytest
+
+_ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(_ROOT))              # repo root（src.* 解決）
+
+fitz = pytest.importorskip("fitz")          # PyMuPDF 未導入環境では skip
+
+from src.llm.pdf_extract_chunk import (  # noqa: E402
+    extract_text_pymupdf,
+    extract_text_pymupdf_isolated,
+)
+
+
+def _make_sample_pdf() -> bytes:
+    """3 ページの単純な PDF バイト列を生成する。"""
+    doc = fitz.open()
+    try:
+        for i in range(3):
+            page = doc.new_page()
+            page.insert_text((72, 72), f"sample page {i + 1} body text")
+        return doc.tobytes()
+    finally:
+        doc.close()
+
+
+def test_isolated_matches_direct() -> None:
+    """(a) 隔離版は直接版と同一の (text, page_count) を返す（挙動保存）。"""
+    pdf = _make_sample_pdf()
+    assert extract_text_pymupdf_isolated(pdf) == extract_text_pymupdf(pdf)
+
+
+def test_child_signal_death_is_contained(monkeypatch: pytest.MonkeyPatch) -> None:
+    """(b) 子プロセスが signal 死しても親は生存し ("", 0) を返す。
+
+    実トリガー PDF（MuPDF FzErrorLimit）は GCS 上の特定ファイル固有で本テストからは再現困難
+    なため、子プロセス起動 argv を差し替えて `os.abort()`（SIGABRT）で signal 死を注入し、
+    ラッパーの `returncode < 0 → ("", 0)` 経路を実 subprocess で検証する。
+    """
+    import src.llm.pdf_extract_chunk as mod
+
+    def _crashing_argv(in_path: str, out_path: str) -> list[str]:
+        return [sys.executable, "-c", "import os; os.abort()"]
+
+    monkeypatch.setattr(mod, "_isolated_worker_argv", _crashing_argv)
+    assert mod.extract_text_pymupdf_isolated(b"%PDF-1.7 dummy") == ("", 0)
+
+
+def test_child_timeout_is_contained(monkeypatch: pytest.MonkeyPatch) -> None:
+    """(b') 子プロセスがハングして timeout しても ("", 0) を返す。"""
+    import src.llm.pdf_extract_chunk as mod
+
+    def _hanging_argv(in_path: str, out_path: str) -> list[str]:
+        return [sys.executable, "-c", "import time; time.sleep(30)"]
+
+    monkeypatch.setattr(mod, "_isolated_worker_argv", _hanging_argv)
+    assert mod.extract_text_pymupdf_isolated(b"%PDF-1.7 dummy", timeout=1) == ("", 0)
