+def _extract_worker_main(argv: list[str]) -> int:
+    """`extract_text_pymupdf_isolated` の子プロセス本体（`--extract <in_pdf> <out_txt>`）.
+
+    in_pdf を読み `extract_text_pymupdf` で抽出し、text を out_txt(utf-8)へ、page_count を
+    stdout へ出力して 0 で終了する。ここで PyMuPDF が SIGSEGV/SIGABRT で落ちても、死ぬのは
+    **この子プロセスだけ**であり、親は returncode<0 で検知して当該 PDF を skip する。
+    Python 例外は空抽出（"", 0）として正常終了扱いにする（親は空→pdfminer フォールバック）。
+    """
+    if len(argv) != 3 or argv[0] != "--extract":
+        return 2
+    _, in_path, out_path = argv
+    try:
+        with open(in_path, "rb") as f:
+            pdf_bytes = f.read()
+        text, page_count = extract_text_pymupdf(pdf_bytes)
+    except Exception:  # noqa: BLE001 — 抽出失敗は空扱い（親のフォールバックへ）
+        text, page_count = "", 0
+    with open(out_path, "w", encoding="utf-8") as f:
+        f.write(text)
+    print(page_count)
+    return 0
+
+
+if __name__ == "__main__":
+    import sys
+
+    raise SystemExit(_extract_worker_main(sys.argv[1:]))
