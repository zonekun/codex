# ============================================================
# 投資AIエージェント 環境変数
# ============================================================
# このファイルを .env にコピーして値を設定してください:
#   cp .env.example .env
# ============================================================

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- J-Quants API ---
JQUANTS_API_KEY=your_jquants_api_key
JQUANTS_REFRESH_TOKEN=your_jquants_refresh_token

# --- EDINET API ---
EDINET_API_KEY=your_edinet_api_key

# --- e-STAT API ---
ESTAT_API_KEY=your_estat_appid

# --- Google Cloud ---
GOOGLE_APPLICATION_CREDENTIALS=keys/gcp-service-account.json
GCP_PROJECT_ID=gmailpj-357912

# --- X (Twitter) API ---
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# --- YouTube Data API ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- 証券会社 ---
# SBI証券
SBI_USER_ID=
SBI_PASSWORD=
# kabuステーション
KABU_STATION_API_KEY=
KABU_STATION_API_SECRET=

# --- Database (本番用 PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/investment_agent

# --- General ---
ENV=development
LOG_LEVEL=INFO
